{
  "schema_version": 1,
  "contract_version": "v0.1",
  "target_product_version": "v0.12.1",
  "enforcement": "release-blocking",
  "measurement": {
    "generated_files": "all files in the generated tree, including .jimu/manifest.json",
    "direct_dependencies": "non-indirect modules reported by go list -m",
    "go_closure_files": "non-test Go files in the package closure of ./cmd/server",
    "go_closure_lines": "non-test Go source lines in the package closure of ./cmd/server",
    "non_code_assets": "assets selected by the generated manifest outside cmd, internal, configs, and docs source files",
    "routes": "registered HTTP routes excluding /livez and /readyz",
    "readiness": "4 vCPU / 8 GB, local images; warm means Go build cache and local images are present, cold means the documented first-run path"
  },
  "templates": {
    "minimal": {
      "limits": {
        "generated_files": 280,
        "direct_dependencies": 32,
        "go_closure_files": 86,
        "go_closure_lines": 9700,
        "external_services": 0,
        "business_routes": 0,
        "health_routes": 2,
        "tables": 0,
        "migrations": 0,
        "non_code_assets": 9
      },
      "readiness_seconds": {
        "warm_build": 10,
        "cold_generate_and_start": 60
      }
    },
    "auth": {
      "limits": {
        "generated_files": 420,
        "direct_dependencies": 44,
        "go_closure_files": 165,
        "go_closure_lines": 17800,
        "external_services": 2,
        "business_routes": 31,
        "health_routes": 2,
        "tables": 9,
        "migrations": 11,
        "non_code_assets": 9
      },
      "readiness_seconds": {
        "warm_build": 120,
        "cold_images": 480
      }
    },
    "full": {
      "limits": {
        "generated_files": 822,
        "direct_dependencies": 64,
        "go_closure_files": 375,
        "go_closure_lines": 40400,
        "external_services": 4,
        "business_routes": 94,
        "health_routes": 2,
        "tables": 23,
        "migrations": 26,
        "non_code_assets": 10
      },
      "readiness_seconds": {
        "warm_build": 180,
        "cold_images": 600
      }
    }
  }
}
