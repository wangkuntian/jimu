# Jimu 配置
# 复制为 .env 并替换。其他配置见 configs/app.yaml / configs/app.prod.yaml
#
# 加载方式：
#   - docker compose 自动读取项目根 .env（变量插值）
#   - make 通过 include .env + export 注入子进程（compose / 部署脚本）

# === 环境 ===
# 可选值:
#   dev  - 开发环境（加载 app.yaml，启动 adminer）
#   prod - 生产环境（加载 app.yaml + app.prod.yaml，不启动 adminer）
APP_ENV=dev

# === MariaDB 容器 ===
DB_ROOT_PASSWORD=change-this-root-password

# === 应用配置（覆盖 app.yaml） ===
# 本地直连用 127.0.0.1；docker compose 内用容器名（mariadb / redis）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jimu
DB_PASSWORD=change-this-jimu-db-password
DB_NAME=jimu
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=01234567890123456789012345678901

# === Compose 覆盖（docker-compose.yml 插值，缺省用 yml 内默认） ===
# Compose 数据库主机与端口（compose 内网使用容器名）
COMPOSE_DB_HOST=mariadb
COMPOSE_DB_PORT=3306
COMPOSE_DB_USER=jimu
COMPOSE_DB_NAME=jimu
COMPOSE_REDIS_ADDR=redis:6379
COMPOSE_REDIS_DB=0
# Secret 文件路径（Docker Secrets 注入；默认 ./secrets/ 下同名 .txt）
COMPOSE_DB_ROOT_PASSWORD_FILE=./secrets/db_root_password.txt
COMPOSE_DB_PASSWORD_FILE=./secrets/db_password.txt
COMPOSE_JWT_SECRET_FILE=./secrets/jwt_secret.txt
# 端口映射
HTTP_HOST_PORT=8080
MANAGEMENT_HOST_PORT=9090
# 应用镜像（compose build 产物）
JIMU_IMAGE=jimu:latest
# 数据卷名（多环境隔离时覆盖）
COMPOSE_MARIADB_VOLUME=jimu-mariadb-data
COMPOSE_REDIS_VOLUME=jimu-redis-data
COMPOSE_OPENOBSERVE_VOLUME=jimu-openobserve-data

# === OpenObserve（observability profile） ===
# 映射端口
ZO_OBSERVE_HTTP_PORT=5080
ZO_OBSERVE_GRPC_PORT=5081
# 管理员账号（必须满足强度：8-128 字符，含大小写字母/数字/特殊字符）
# server 的 OTEL_AUTH_EMAIL/OTEL_AUTH_PASSWORD 默认跟随此账号
ZO_OBSERVE_ROOT_USER_EMAIL=admin@jimu.local
ZO_OBSERVE_ROOT_USER_PASSWORD=Admin@12345
# OTel Collector 使用的基础 token（base64(email:password)）。
# 一般无需设置：默认值由 ZO_OBSERVE_ROOT_USER_* 决定；若自定义本值，
# 需保证与邮箱密码一致，否则 collector 写入被认证拒绝
ZO_OBSERVE_AUTH_TOKEN=

# === 应用 → OpenObserve（OTEL 推送） ===
# 开启后 server 的 tracing/metrics/logs 经 OTLP/gRPC 推送到 OpenObserve
OTEL_ENABLED=false
# compose 内指向 openobserve 服务；本地非容器运行用 localhost:5081
OTEL_ENDPOINT=openobserve:5081
OTEL_ORG_ID=default