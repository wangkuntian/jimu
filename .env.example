# ============================================
# Jimu Backend Framework - 环境变量配置
# 复制为 .env 后修改：cp .env.example .env
# ============================================

# 运行环境：dev / test / prod
JIMU_ENV=prod

# ---------- HTTP ----------
HTTP_PORT=8080

# ---------- Database (MariaDB) ----------
DB_PORT=3306
DB_PASSWORD=root
DB_DATABASE=jimu
JIMU__DB__HOST=mariadb
JIMU__DB__PORT=3306
JIMU__DB__USER=root

# ---------- Redis ----------
REDIS_PORT=6379
JIMU__REDIS__ADDR=redis:6379

# ---------- Adminer (数据库管理) ----------
ADMINER_PORT=8081

# ---------- Auth ----------
JWT_SECRET=change-me-in-production
JIMU__AUTH__JWT_SECRET=${JWT_SECRET}

# ---------- Seed ----------
JIMU_ADMIN_PASSWORD=admin123
