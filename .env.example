# Jimu Compose environment
# Copy to .env and replace all password/secret values before production use.

JIMU_ENV=prod

# Public HTTP port. Management port is bound to 127.0.0.1 by docker-compose.yml.
HTTP_PORT=8080
MANAGEMENT_PORT=9090

# MariaDB
DB_ROOT_PASSWORD=change-this-root-password
DB_USER=jimu
DB_PASSWORD=change-this-jimu-db-password
DB_DATABASE=jimu

# Redis
# Adminer is only started with: docker compose --profile dev up -d adminer
ADMINER_PORT=8081

# Runtime overrides consumed by the server container.
JIMU__DB__HOST=mariadb
JIMU__DB__PORT=3306
JIMU__DB__USER=jimu
JIMU__DB__PASSWORD=change-this-jimu-db-password
JIMU__REDIS__ADDR=redis:6379
JIMU__AUTH__JWT_SECRET=01234567890123456789012345678901
JIMU__AUTH__PUBLIC_REGISTRATION=false
JIMU__HTTP__ALLOWED_ORIGINS=http://localhost:3000
