# ============================================
# Jimu Backend Framework - 环境变量配置
# 复制为 .env 后修改：cp .env.example .env
# ============================================

# 运行环境：dev / test / prod
JIMU_ENV=prod

# ---------- HTTP ----------
HTTP_PORT=8080

# ---------- Database (MariaDB) ----------
DB_PORT=3306
DB_PASSWORD=root
DB_DATABASE=jimu

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Adminer (数据库管理) ----------
ADMINER_PORT=8081

# ---------- Auth ----------
JWT_SECRET=change-me-in-production

# ---------- Seed ----------
JIMU_ADMIN_PASSWORD=admin123
