# Jimu 配置
# 复制为 .env 并替换。其他配置见 configs/app.yaml / configs/app.prod.yaml

# === 环境 ===
# 可选值:
#   dev  - 开发环境（加载 app.yaml，启动 adminer）
#   prod - 生产环境（加载 app.yaml + app.prod.yaml，不启动 adminer）
APP_ENV=dev

# === MariaDB 容器 ===
DB_ROOT_PASSWORD=change-this-root-password

# === 应用配置（覆盖 app.yaml） ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jimu
DB_PASSWORD=change-this-jimu-db-password
DB_NAME=jimu
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=01234567890123456789012345678901
