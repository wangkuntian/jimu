services:
{{- if .HasMySQL}}
  mariadb:
    image: mariadb:12.3.3-noble
    restart: unless-stopped
    environment:
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/db_root_password
      MARIADB_DATABASE: {{.ProjectName}}
      MARIADB_USER: {{.ProjectName}}
      MARIADB_PASSWORD_FILE: /run/secrets/db_password
      TZ: Asia/Shanghai
    volumes:
      - {{.ProjectName}}-mariadb-data:/var/lib/mysql
{{- if .HasScripts}}
      - ./deploy/scripts:/opt/jimu/scripts:ro
      - ./backups:/backups
{{- end}}
    ports:
      - "127.0.0.1:${JIMU_DB_HOST_PORT:-3306}:3306"
    healthcheck:
      test: ["CMD-SHELL", "mariadb-admin ping -uroot -p\"$$(cat /run/secrets/db_root_password)\" --silent"]
      interval: 10s
      timeout: 5s
      retries: 5
    secrets:
      - db_root_password
      - db_password
{{- end}}
{{- if .HasRedis}}

  redis:
    image: redis:8.10.3-alpine
    restart: unless-stopped
    volumes:
      - {{.ProjectName}}-redis-data:/data
    ports:
      - "127.0.0.1:${JIMU_REDIS_HOST_PORT:-6379}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- end}}
{{- if .HasMySQL}}

  jimu-init:
    image: ${JIMU_IMAGE:-{{.ProjectName}}:latest}
    restart: "no"
    command: /bin/sh -c './jimu migrate up && ./jimu seed'
    environment:
      APP_ENV: ${APP_ENV:-dev}
      DB_HOST: mariadb
      DB_PORT: "3306"
      DB_USER: {{.ProjectName}}
      DB_NAME: {{.ProjectName}}
      REDIS_ADDR: redis:6379
      REDIS_DB: "0"
      DB_PASSWORD_FILE: /run/secrets/db_password
      JWT_SECRET_FILE: /run/secrets/jwt_secret
      ENCRYPTION_KEY_FILE: /run/secrets/encryption_key
      AUDIT_HASH_SECRET_FILE: /run/secrets/audit_hash_secret
      ADMIN_PASSWORD_FILE: /run/secrets/admin_password
    volumes:
      - ./configs:/app/configs
    depends_on:
      mariadb:
        condition: service_healthy
      redis:
        condition: service_healthy
    secrets:
      - db_password
      - jwt_secret
      - encryption_key
      - audit_hash_secret
      - admin_password
{{- end}}

  server:
    image: ${JIMU_IMAGE:-{{.ProjectName}}:latest}
    build:
      context: .
      dockerfile: deploy/docker/Dockerfile
    restart: unless-stopped
    environment:
      APP_ENV: ${APP_ENV:-dev}
{{- if .HasMySQL}}
      DB_HOST: mariadb
      DB_PORT: "3306"
      DB_USER: {{.ProjectName}}
      DB_NAME: {{.ProjectName}}
{{- end}}
{{- if .HasRedis}}
      REDIS_ADDR: redis:6379
      REDIS_DB: "0"
{{- end}}
      MANAGEMENT_HOST: "0.0.0.0"
{{- if .HasMySQL}}
      DB_PASSWORD_FILE: /run/secrets/db_password
      JWT_SECRET_FILE: /run/secrets/jwt_secret
      ENCRYPTION_KEY_FILE: /run/secrets/encryption_key
      AUDIT_HASH_SECRET_FILE: /run/secrets/audit_hash_secret
      ADMIN_PASSWORD_FILE: /run/secrets/admin_password
{{- end}}
    ports:
      - "127.0.0.1:${HTTP_HOST_PORT:-8080}:8080"
      - "127.0.0.1:${MANAGEMENT_HOST_PORT:-9090}:9090"
    volumes:
      - ./configs:/app/configs
      - ./logs:/app/logs
{{- if .HasMySQL}}
    depends_on:
      jimu-init:
        condition: service_completed_successfully
    secrets:
      - db_password
      - jwt_secret
      - encryption_key
      - audit_hash_secret
      - admin_password
{{- end}}
{{- if .HasMySQL}}
secrets:
  db_root_password:
    file: ${JIMU_SECRETS_DIR:-./secrets}/db_root_password.txt
  db_password:
    file: ${JIMU_SECRETS_DIR:-./secrets}/db_password.txt
  jwt_secret:
    file: ${JIMU_SECRETS_DIR:-./secrets}/jwt_secret.txt
  encryption_key:
    file: ${JIMU_SECRETS_DIR:-./secrets}/encryption_key.txt
  audit_hash_secret:
    file: ${JIMU_SECRETS_DIR:-./secrets}/audit_hash_secret.txt
  admin_password:
    file: ${JIMU_SECRETS_DIR:-./secrets}/admin_password.txt
{{- end}}
