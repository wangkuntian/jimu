services:
  server:
    env_file:
      - path: ${JIMU_SECRETS_DIR:-./secrets}/openobserve.env
        required: false
    environment:
      OTEL_ENABLED: "true"
      OTEL_ENDPOINT: openobserve:5081

  openobserve:
    image: public.ecr.aws/zinclabs/openobserve:v1.1.2
    restart: unless-stopped
    env_file:
      - path: ${JIMU_SECRETS_DIR:-./secrets}/openobserve.env
        required: false
    environment:
      ZO_DATA_DIR: /data
      ZO_HTTP_PORT: "5080"
      ZO_GRPC_PORT: "5081"
    volumes:
      - {{.ProjectName}}-openobserve-data:/data
    ports:
      - "127.0.0.1:${ZO_OBSERVE_HTTP_PORT:-5080}:5080"
      - "127.0.0.1:${ZO_OBSERVE_GRPC_PORT:-5081}:5081"

  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.164.0
    restart: unless-stopped
    command: ["--config=/etc/otelcol/config.yaml"]
    volumes:
      - ./deploy/observability/otel-collector.yaml:/etc/otelcol/config.yaml:ro
    environment:
      ZO_ORG: ${OTEL_ORG_ID:-default}
      ZO_OTLP_ENDPOINT: openobserve:5081
{{- if .HasMySQL}}
      MYSQL_ENDPOINT: mariadb:3306
      MYSQL_USER: root
{{- end}}
{{- if .HasRedis}}
      REDIS_ENDPOINT: redis:6379
{{- end}}
    secrets:
{{- if .HasMySQL}}
      - db_root_password
{{- end}}
      - zo_auth_token
    depends_on:
      openobserve:
        condition: service_started
{{- if .HasMySQL}}
      mariadb:
        condition: service_healthy
{{- end}}
{{- if .HasRedis}}
      redis:
        condition: service_healthy
{{- end}}

volumes:
  {{.ProjectName}}-openobserve-data:
    name: ${COMPOSE_OPENOBSERVE_VOLUME:-{{.ProjectName}}-openobserve-data}

secrets:
  zo_auth_token:
    file: ${JIMU_SECRETS_DIR:-./secrets}/zo_auth_token.txt
{{- if .HasMySQL}}
  db_root_password:
    file: ${JIMU_SECRETS_DIR:-./secrets}/db_root_password.txt
{{- end}}
