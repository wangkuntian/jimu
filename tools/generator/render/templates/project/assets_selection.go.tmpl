package profileassets

// GeneratedSelection lists the asset files copied into this project.
var GeneratedSelection = []string{
{{- range .Files }}
	{{ printf "%q" . }},
{{- end }}
}

// IsGeneratedProject reports whether this file belongs to a generated project.
func IsGeneratedProject() bool { return true }

// SelectedFiles returns the generated asset selection.
func SelectedFiles() []string {
	return append([]string(nil), GeneratedSelection...)
}
