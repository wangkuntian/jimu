func TestAuthAPIRouteCountAndUnauthorizedAccess(t *testing.T) {
	log, err := logging.New(logging.DefaultTestLogConfig())
	if err != nil {
		t.Fatal(err)
	}
	cfg := &config.Config{HTTP: config.HTTPConfig{
		Mode:           "test",
		MaxBodyBytes:   1 << 20,
		AllowedOrigins: []string{"https://app.example"},
	}}
	tokens := auth.NewTokenManager(config.AuthConfig{
		JWTSecret: "test-secret-for-jwt-signing-123", Issuer: "jimu", AccessExpireMin: 5, RefreshExpireDay: 1,
	})
	router, err := NewRouter(log, cfg, nil, nil, tokens)
	if err != nil {
		t.Fatal(err)
	}
	if got := len(router.Routes()); got != 24 {
		t.Fatalf("route count = %d, want 24", got)
	}
	recorder := httptest.NewRecorder()
	request := httptest.NewRequest(http.MethodGet, "/api/v1/users", nil)
	request.Header.Set("Origin", "https://app.example")
	router.ServeHTTP(recorder, request)
	if recorder.Code != http.StatusUnauthorized {
		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusUnauthorized)
	}
	if got := recorder.Header().Get("X-Content-Type-Options"); got != "nosniff" {
		t.Fatalf("X-Content-Type-Options = %q", got)
	}
	if got := recorder.Header().Get("Access-Control-Allow-Origin"); got != "https://app.example" {
		t.Fatalf("Access-Control-Allow-Origin = %q", got)
	}
}

func TestUpdateUserPasswordRejectsShortInput(t *testing.T) {
	gin.SetMode(gin.TestMode)
	for _, tc := range []struct {
		name string
		body string
	}{
		{name: "empty", body: `{"password":""}`},
		{name: "seven_characters", body: `{"password":"1234567"}`},
	} {
		t.Run(tc.name, func(t *testing.T) {
			recorder := httptest.NewRecorder()
			ctx, _ := gin.CreateTestContext(recorder)
			ctx.Request = httptest.NewRequest(http.MethodPut, "/api/v1/users/1", strings.NewReader(tc.body))
			ctx.Request.Header.Set("Content-Type", "application/json")

			if _, ok := bindJSON[updateUserRequest](ctx); ok {
				t.Fatal("short password passed request validation")
			}
			if recorder.Code != http.StatusBadRequest {
				t.Fatalf("status = %d, want %d", recorder.Code, http.StatusBadRequest)
			}
		})
	}
}
