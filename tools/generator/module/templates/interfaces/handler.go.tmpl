	}
	response.OK(c, entity)
}

func (h *{{.NameCamel}}Handler) List(c *gin.Context) {
	p := c.MustGet("validated_query").(*pagination.Pagination)
	if err := p.Normalize("id", "name", "created_at"); err != nil {
