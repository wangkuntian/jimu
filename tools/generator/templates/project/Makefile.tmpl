.PHONY: help build build-server build-cli run test vet fmt fmt-check lint clean ci
.PHONY: check-log-usage check-capabilities profiles-check compose-report
.PHONY: migrate migrate-down migrate-status seed
{{if .HasAPIdocs}}.PHONY: swagger swagger-check
{{end}}
# 默认目标
.DEFAULT_GOAL := help

# 变量
BIN_DIR := bin
# 本项目是**单形态**项目：形态在生成期已确定（internal/profiles/active 就是本形态的选点），
# 构建与运行直接 go build / go run，不需要任何构建期形态叠加 —— 本 Makefile 没有 PROFILE，
# 也没有任何 overlay 步骤。
SERVER_PKG := ./cmd/server
CLI_PKG := ./cmd/cli
SERVER_CMD := cmd/server/main.go
SERVER_BIN = $(BIN_DIR)/jimu-server
CLI_BIN = $(BIN_DIR)/jimu-cli
VERSION ?= dev
ENV ?= dev
# 注入版本号到两个 main 包
LDFLAGS := -X main.version=$(VERSION)
# golangci-lint 版本：与框架 .github/workflows/ci.yml 的 GOLANGCI_LINT_VERSION 一致，
# 使本地 make lint 与 CI 的 lint 结论含义相同。
LINT_VERSION ?= v2.7.2
{{if .HasAPIdocs}}SWAG := go run -mod=mod github.com/swaggo/swag/cmd/swag
{{end}}
# CLI 运行：本项目只有一个形态，直接 go run。
CLI_RUN = APP_ENV=$(ENV) go run $(CLI_PKG)

# 加载 .env 文件（如果存在），导出敏感变量供本文件中的命令使用
ifneq (,$(wildcard .env))
    include .env
    export
endif

## help: 显示帮助信息
help:
	@echo "项目 Makefile（单形态，无 PROFILE 分支）"
	@echo ""
	@echo "Usage: make <target>"
	@echo ""
	@echo "本地运行:"
	@echo "  make run                  编译并运行服务端"
	@echo "  make build                编译服务端和 CLI"
	@echo "  make build-server         编译服务端（$(SERVER_BIN)）"
	@echo "  make test                 运行测试"
	@echo "  make vet                  静态分析"
	@echo "  make fmt                  格式化代码"
	@echo "  make lint                 静态检查"
	@echo "  make check-log-usage      检查日志调用均为 *w 系列（防 k/v 粘连）"
	@echo "  make check-capabilities   校验能力自描述（Owns）与驱动可用集/选中集一致"
	@echo "  make profiles-check       构建本项目唯一形态 + golden 依赖闭包门禁"
	@echo "                            （JIMU_PROFILES_SMOKE=1 时额外启动并检查 /readyz）"
	@echo "  make compose-report       生成编译面报告 docs/profiles/compose-report.md"
	@echo ""
	@echo "数据库:"
	@echo "  make migrate              本地执行迁移"
	@echo "  make migrate-down         本地回滚迁移"
	@echo "  make migrate-status       查看迁移状态"
	@echo "  make seed                 本地插入初始数据"
	@echo ""
	@echo "工具:"
	@echo "  make clean                清理构建产物"
{{if .HasAPIdocs}}	@echo "  make swagger              生成 API 文档（docs/openapi）"
	@echo "  make swagger-check        校验 API 文档为最新"
{{end}}	@echo "  make ci                   本地 CI 检查（fmt/vet/lint/test/check-capabilities/build）"

# ========== 本地运行 ==========

## run: 编译并运行服务端
run: build-server
	APP_ENV=$(ENV) ./$(SERVER_BIN)

## build: 编译服务端和 CLI
build: build-server build-cli

## build-server: 编译服务端（单形态，普通 go build）
build-server:
	@mkdir -p $(BIN_DIR)
	go build -ldflags "$(LDFLAGS)" -o $(SERVER_BIN) $(SERVER_PKG)

## build-cli: 编译 CLI（单形态，普通 go build）
build-cli:
	@mkdir -p $(BIN_DIR)
	go build -ldflags "$(LDFLAGS)" -o $(CLI_BIN) $(CLI_PKG)

# ========== 数据库 ==========

## migrate: 本地执行迁移
migrate:
	@$(CLI_RUN) migrate up

## migrate-down: 本地回滚迁移
migrate-down:
	@$(CLI_RUN) migrate down

## migrate-status: 查看迁移状态
migrate-status:
	@$(CLI_RUN) migrate status

## seed: 本地插入初始数据
seed:
	@$(CLI_RUN) seed

# ========== 工具 ==========

## test: 运行测试
test:
	go test ./...

## vet: 静态分析
vet:
	go vet ./...

## fmt: 格式化代码
fmt:
	go fmt ./...

## fmt-check: 检查代码格式（不修改）
fmt-check:
	@echo "Checking gofmt..."
	@if gofmt -l . | grep -q .; then \
		echo "以下文件需要格式化:"; \
		gofmt -l .; \
		exit 1; \
	else \
		echo "所有文件格式正确"; \
	fi

## lint: 静态检查（需要 golangci-lint；版本与 CI 一致，见 LINT_VERSION）
lint:
	@if command -v golangci-lint >/dev/null 2>&1 && golangci-lint version 2>/dev/null | grep -qw "$(LINT_VERSION:v%=%)"; then \
		golangci-lint run ./...; \
	elif command -v golangci-lint >/dev/null 2>&1; then \
		echo "本地 golangci-lint 版本与 CI（$(LINT_VERSION)）不一致，改用 go run 固定版本"; \
		go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$(LINT_VERSION) run ./...; \
	else \
		echo "golangci-lint 未安装，使用 go vet 替代"; \
		go vet ./...; \
	fi

## check-log-usage: 检查日志调用符合结构化规范（logcheck 静态分析：防粘连 R1 /
## 禁动态 key R2 / 字段词汇表 R3 / 禁嵌套对象 R4；规则与 AGENTS.md 日志调用规范同步）
check-log-usage:
	@go run ./tools/logcheck "./internal/..." "./cmd/..." "./tools/..."

## check-capabilities: 校验能力自描述（Owns）与迁移归属一致，并静态门禁驱动选择
##                      （可用集目录存在、核心零驱动、唯一形态选中集==import 闭包、驱动归属）
check-capabilities:
	@go run ./tools/checkcapabilities

## profiles-check: 构建本项目唯一形态 + golden 依赖闭包门禁，构建或门禁失败即非零退出。
##                 设置 JIMU_PROFILES_SMOKE=1 后额外以 APP_ENV=dev 启动并轮询 /readyz
##                 （需 DB+Redis）；未设置时打印 SKIP，不静默跳过。
profiles-check:
	@bash scripts/check_profiles.sh

## compose-report: 生成本项目唯一形态的编译面报告（docs/profiles/compose-report.md，入库）。
##                 指标：二进制大小 / 路由数 / 迁移数 / 表数 / 闭包代码量与文件数 /
##                 重型依赖 / go.mod 直接依赖数；不连库、不启动监听。
compose-report:
	@go run ./tools/composereport

## clean: 清理构建产物
clean:
	rm -rf $(BIN_DIR)
	rm -f coverage.out coverage.html

{{if .HasAPIdocs}}## swagger: 生成 API 文档（本项目已编入 apidocs）
swagger:
	$(SWAG) init -g $(SERVER_CMD) -o docs/openapi

## swagger-check: 校验 API 文档为最新（与 CI Test job 一致）
swagger-check:
	$(SWAG) init -g $(SERVER_CMD) -o docs/openapi >/dev/null || exit 1; \
	git diff --exit-code docs/openapi || { echo "❌ docs/openapi 不是最新，请运行 make swagger"; exit 1; }; \
	echo "✅ OpenAPI 文档为最新"

{{end}}## ci: 本地 CI 检查（无外部依赖部分）
ci: fmt-check vet lint check-log-usage test check-capabilities{{if .HasAPIdocs}} swagger-check{{end}} build
	@echo "✅ All local CI checks passed"
