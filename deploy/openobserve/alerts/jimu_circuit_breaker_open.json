{
  "name": "jimu_circuit_breaker_open",
  "stream_type": "metrics",
  "stream_name": "jimu_httpclient_circuit_open",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "promql": "max(jimu_httpclient_circuit_open)",
    "promql_condition": { "column": "value", "operator": ">", "value": 0 }
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 2,
    "frequency_type": "minutes",
    "silence": 15
  },
  "destinations": ["jimu_webhook"],
  "description": "出站 HTTP 客户端熔断器处于打开状态（下游连续失败）",
  "enabled": true
}
