{
  "name": "jimu_queue_deadletters",
  "stream_type": "metrics",
  "stream_name": "jimu_queue_deadletters_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "promql": "sum(increase(jimu_queue_deadletters_total[10m]))",
    "promql_condition": { "column": "value", "operator": ">", "value": 0 }
  },
  "trigger_condition": {
    "period": 10,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "frequency_type": "minutes",
    "silence": 30
  },
  "destinations": ["jimu_webhook"],
  "description": "10 分钟窗口内出现队列死信任务（重试耗尽后进入死信）",
  "enabled": true
}
