{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"jimu-server\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "P95 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"jimu-server\"}[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"jimu-server\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"jimu-server\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"jimu-server\"}[5m]))",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "title": "DB Connection Pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "jimu_db_connections_in_use{job=\"jimu-server\"}",
          "legendFormat": "In Use"
        },
        {
          "expr": "jimu_db_connections_max{job=\"jimu-server\"}",
          "legendFormat": "Max"
        }
      ]
    },
    {
      "title": "Go Runtime",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "go_goroutines{job=\"jimu-server\"}",
          "legendFormat": "Goroutines"
        },
        {
          "expr": "go_memstats_alloc_bytes{job=\"jimu-server\"} / 1024 / 1024",
          "legendFormat": "Alloc MB"
        }
      ]
    },
    {
      "title": "HTTP Status Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (status) (http_requests_total{job=\"jimu-server\"})",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["jimu", "go", "api"],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "query": "label_values(http_requests_total, job)",
        "current": { "text": "jimu-server", "value": "jimu-server" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Jimu Server Dashboard",
  "uid": "jimu-server",
  "version": 1
}
